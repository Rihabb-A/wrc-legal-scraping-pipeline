# Copy this file to .env and fill in real values.
# .env is git-ignored so real credentials never reach GitHub.
# Values below are the local Docker defaults used in later phases.

# --- MongoDB (metadata store) ---
MONGO_URI=mongodb://localhost:27017
MONGO_DB=wrc
MONGO_LANDING_COLLECTION=landing_documents
MONGO_CURATED_COLLECTION=curated_documents

# --- MinIO (object storage for the actual files) ---
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_SECURE=false
MINIO_LANDING_BUCKET=wrc-landing
MINIO_CURATED_BUCKET=wrc-curated

# --- Scraping behaviour ---
PARTITION_SIZE=monthly
CONCURRENT_REQUESTS=8
DOWNLOAD_DELAY=0.25
RETRY_TIMES=3
DOWNLOAD_TIMEOUT=60

# --- Logging ---
LOG_LEVEL=INFO
LOG_FILE=structured_log.jsonl
