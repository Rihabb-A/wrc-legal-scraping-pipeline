# Copy this file to .env and fill in real values:
#     cp .env.example .env
#
# .env is git-ignored, so real credentials never reach GitHub.
# docker-compose.yml reads this file too, so the containers and the Python
# code always agree on ports, buckets and credentials.

# --- MongoDB: metadata ---
MONGO_PORT=27017
MONGO_URI=mongodb://localhost:27017
MONGO_DB=wrc
MONGO_LANDING_COLLECTION=landing_documents
MONGO_CURATED_COLLECTION=curated_documents

# --- MinIO: the document files ---
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_ENDPOINT=localhost:9000
# Also used as the MinIO root credentials by docker-compose.
# Change these for anything that is not a local development machine.
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_SECURE=false
MINIO_LANDING_BUCKET=wrc-landing
MINIO_CURATED_BUCKET=wrc-curated

# --- Scraping behaviour ---
PARTITION_SIZE=monthly
CONCURRENT_REQUESTS=8
DOWNLOAD_DELAY=0.25
RETRY_TIMES=3
DOWNLOAD_TIMEOUT=60

# --- Logging ---
LOG_LEVEL=INFO
LOG_FILE=structured_log.jsonl
